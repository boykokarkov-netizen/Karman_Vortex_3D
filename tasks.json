{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build QUDA Hello World",
            "command": "/usr/bin/g++-12",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-I/home/userbk/CUDA/quda/include",
                "-I/home/userbk/CUDA/quda/build/include",
                "-L/home/userbk/CUDA/quda/build/lib",
                "-lquda",
                "-lcudart",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++-12 build active file",
            "command": "/usr/bin/g++-12",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O3",
                "-mavx2",
                "-mfma",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I/home/userbk/CUDA/quda/include",
                "-I/home/userbk/CUDA/quda/build/include"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
